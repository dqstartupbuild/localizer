{
  "name": "localizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "dev": "next dev --turbo --hostname 127.0.0.1",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,md,mdx,json}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,md,mdx,json}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "localizer": "node packages/localizer-cli/src/index.mjs",
    "test:localizer-roundtrip": "node scripts/localizer-roundtrip.mjs",
    "test:localizer-analyzer": "swift test --package-path packages/localizer-analyzer",
    "test:localizer-mcp": "node scripts/localizer-mcp.mjs",
    "test:localizer-mcp-configuration": "node scripts/localizer-mcp-configuration.mjs",
    "test:localizer-xcode-integration": "node scripts/localizer-xcode-integration.mjs",
    "test:localizer-verification": "node scripts/localizer-verification.mjs",
    "test:localizer-strict-check": "node scripts/localizer-strict-check.mjs",
    "test:localizer-routing": "node scripts/localizer-routing.mjs",
    "test:production-preview": "npm run build && node scripts/production-preview.mjs",
    "test": "npm run test:localizer-analyzer && npm run test:localizer-roundtrip && npm run test:localizer-mcp && npm run test:localizer-mcp-configuration && npm run test:localizer-xcode-integration && npm run test:localizer-verification && npm run test:localizer-strict-check && npm run test:localizer-routing && npm run test:production-preview"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "lucide-react": "^1.17.0",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.5.1"
}
